<!DOCTYPE html>
<html lang="en" class="dark">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>WeShare</title>
    <base href="/" />
    <ResourcePreloader />
    <link rel="icon" type="image/png" href="favicon.png" />
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = { darkMode: 'class' };
        function scrollIntoView(element) { element.scrollIntoView({ behavior: 'smooth' }); }
    </script>
    <style>
        input[type=number]::-webkit-inner-spin-button,
        input[type=number]::-webkit-outer-spin-button { -webkit-appearance: none; }
        input[type=number] { -moz-appearance: textfield; appearance: textfield; }
    </style>
    <ImportMap />
    <HeadOutlet />
</head>

<body class="bg-zinc-950 text-zinc-100 antialiased">
    <WeShareClone.Web.AppRoutes @rendermode="new InteractiveWebAssemblyRenderMode(prerender: false)" />

    <div id="blazor-error-ui" class="hidden fixed bottom-4 left-4 right-4 bg-red-900 border border-red-700 text-red-100 rounded-xl px-4 py-3 text-sm z-50">
        An unhandled error has occurred.
        <a href="." class="underline ml-2">Reload</a>
        <span class="dismiss float-right cursor-pointer ml-4">✕</span>
    </div>

    <script src="@Assets["_framework/blazor.web.js"]"></script>
</body>

</html>
