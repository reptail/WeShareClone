@inject SettlementService SettlementService

<!-- Backdrop -->
<div class="fixed inset-0 bg-black/60 backdrop-blur-sm z-40 flex items-end sm:items-center justify-center p-4"
     @onclick="OnClose">
    <div class="bg-zinc-900 border border-zinc-800 rounded-2xl p-6 w-full max-w-sm space-y-4"
         @onclick:stopPropagation="true">
        <h2 class="font-semibold text-lg">New Settlement</h2>

        <div class="space-y-3">
            <div class="space-y-1">
                <label class="text-sm text-zinc-400">Name</label>
                <input @bind="_name"
                       placeholder="Trip to Copenhagen…"
                       class="w-full bg-zinc-800 border border-zinc-700 rounded-xl px-4 py-2.5 text-sm text-zinc-100 placeholder:text-zinc-500 focus:outline-none focus:border-violet-500 transition-colors" />
            </div>

            <div class="space-y-1">
                <label class="text-sm text-zinc-400">Currency</label>
                <input @bind="_currency"
                       maxlength="3"
                       placeholder="DKK"
                       class="w-full bg-zinc-800 border border-zinc-700 rounded-xl px-4 py-2.5 text-sm text-zinc-100 placeholder:text-zinc-500 focus:outline-none focus:border-violet-500 transition-colors uppercase" />
            </div>
        </div>

        @if (_errorMessage is not null)
        {
            <p class="text-sm text-red-400">@_errorMessage</p>
        }

        <div class="flex gap-2 pt-1">
            <button @onclick="OnClose"
                    class="flex-1 bg-zinc-800 hover:bg-zinc-700 text-zinc-300 font-medium py-2.5 rounded-xl text-sm transition-colors cursor-pointer">
                Cancel
            </button>
            <button @onclick="CreateAsync"
                    disabled="@_loading"
                    class="flex-1 bg-violet-600 hover:bg-violet-500 disabled:opacity-50 disabled:cursor-not-allowed text-white font-medium py-2.5 rounded-xl text-sm transition-colors cursor-pointer">
                @(_loading ? "Creating…" : "Create")
            </button>
        </div>
    </div>
</div>

@code {
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback<SettlementModel> OnCreated { get; set; }

    private string _name = string.Empty;
    private string _currency = "DKK";
    private bool _loading;
    private string? _errorMessage;

    private async Task CreateAsync()
    {
        _errorMessage = null;

        if (string.IsNullOrWhiteSpace(_name))
        {
            _errorMessage = "Please enter a name.";
            return;
        }

        if (_currency.Length != 3)
        {
            _errorMessage = "Currency must be a 3-letter ISO code (e.g. DKK).";
            return;
        }

        _loading = true;

        try
        {
            SettlementModel? settlement = await SettlementService.CreateAsync(
                _name.Trim(),
                _currency.Trim().ToUpperInvariant()
            );

            if (settlement is not null)
            {
                await OnCreated.InvokeAsync(settlement);
            }
        }
        catch
        {
            _errorMessage = "Failed to create settlement. Please try again.";
        }
        finally
        {
            _loading = false;
        }
    }
}
