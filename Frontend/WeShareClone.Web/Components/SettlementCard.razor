@inject EntryService EntryService

<div class="bg-zinc-900 border border-zinc-800 rounded-xl px-4 py-3 cursor-pointer hover:bg-zinc-800 transition-colors active:scale-[0.99]"
     @onclick="OnClick">
    <div class="flex items-start justify-between gap-3">
        <div class="min-w-0">
            <p class="font-medium text-zinc-100 truncate">@Settlement.Name</p>
            <p class="text-xs text-zinc-500 mt-0.5">@Settlement.Currency</p>
        </div>

        <div class="text-right shrink-0">
            @if (_balanceLoading)
            {
                <div class="h-4 w-16 bg-zinc-800 rounded animate-pulse"></div>
            }
            else if (_balance > 0)
            {
                <p class="text-sm font-semibold text-green-400">+@_balance.ToString("N2")</p>
                <p class="text-xs text-zinc-500">owed to you</p>
            }
            else if (_balance < 0)
            {
                <p class="text-sm font-semibold text-red-400">@_balance.ToString("N2")</p>
                <p class="text-xs text-zinc-500">you owe</p>
            }
            else
            {
                <p class="text-sm text-zinc-500">Settled up</p>
            }
        </div>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public SettlementModel Settlement { get; set; } = null!;
    [Parameter, EditorRequired] public int CurrentUserId { get; set; }
    [Parameter] public EventCallback OnClick { get; set; }

    private decimal _balance;
    private bool _balanceLoading = true;

    protected override async Task OnParametersSetAsync()
    {
        _balanceLoading = true;
        EntryModel[] entries = await EntryService.GetEntriesAsync(Settlement.Id);
        _balance = CalculateBalance(entries);
        _balanceLoading = false;
    }

    private decimal CalculateBalance(EntryModel[] entries)
    {
        decimal total = 0;

        foreach (EntryModel entry in entries)
        {
            EntryDistributionModel? dist = entry.Distributions
                .FirstOrDefault(d => d.UserId == CurrentUserId);

            decimal userShare = (dist is null) ? 0 : entry.DistributionMode switch
            {
                "EvenSplit"   => entry.Distributions.Length > 0 ? entry.Value / entry.Distributions.Length : 0,
                "Percentage"  => entry.Value * dist.Factor,
                "FixedAmount" => dist.Factor,
                _             => 0
            };

            total += (entry.AddedBy == CurrentUserId ? entry.Value : 0) - userShare;
        }

        return total;
    }
}
