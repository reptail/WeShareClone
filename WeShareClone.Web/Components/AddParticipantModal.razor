@inject UserService UserService
@inject SettlementService SettlementService

<!-- Backdrop -->
<div class="fixed inset-0 bg-black/60 backdrop-blur-sm z-40 flex items-end sm:items-center justify-center p-4"
     @onclick="OnClose">
    <div class="bg-zinc-900 border border-zinc-800 rounded-2xl p-6 w-full max-w-sm space-y-4"
         @onclick:stopPropagation="true">
        <h2 class="font-semibold text-lg">Add Participant</h2>

        <!-- Search input -->
        <div class="space-y-3">
            <div class="space-y-1">
                <label class="text-sm text-zinc-400">Name or email</label>
                <div class="flex gap-2">
                    <input @bind="_query"
                           @bind:event="oninput"
                           @onkeydown="OnKeyDown"
                           type="text"
                           placeholder="Search…"
                           disabled="@_loading"
                           class="flex-1 bg-zinc-800 border border-zinc-700 rounded-xl px-4 py-2.5 text-sm text-zinc-100 placeholder:text-zinc-500 focus:outline-none focus:border-violet-500 transition-colors" />
                    <button @onclick="SearchAsync"
                            disabled="@(string.IsNullOrWhiteSpace(_query) || _loading)"
                            class="bg-zinc-700 hover:bg-zinc-600 disabled:opacity-50 disabled:cursor-not-allowed text-zinc-100 font-medium px-4 rounded-xl text-sm transition-colors cursor-pointer">
                        @(_loading ? "…" : "Search")
                    </button>
                </div>
            </div>

            <!-- Results list -->
            @if (_results.Length > 0)
            {
                <div class="space-y-2 max-h-52 overflow-y-auto">
                    @foreach (UserModel user in _results)
                    {
                        bool alreadyAdded = ExistingParticipants.Any(p => p.Id == user.Id);
                        <div class="bg-zinc-800 border border-zinc-700 rounded-xl px-4 py-2.5 flex items-center justify-between gap-3">
                            <div class="min-w-0">
                                <p class="text-sm font-medium text-zinc-100 truncate">@user.Name</p>
                                <p class="text-xs text-zinc-500 truncate">@user.Email</p>
                            </div>
                            <button @onclick="() => AddAsync(user)"
                                    disabled="@(alreadyAdded || _addingId == user.Id)"
                                    class="shrink-0 bg-violet-600 hover:bg-violet-500 disabled:opacity-50 disabled:cursor-not-allowed text-white font-medium px-3 py-1.5 rounded-lg text-xs transition-colors cursor-pointer">
                                @if (_addingId == user.Id)
                                {
                                    <span>Adding…</span>
                                }
                                else if (alreadyAdded)
                                {
                                    <span>Added</span>
                                }
                                else
                                {
                                    <span>Add</span>
                                }
                            </button>
                        </div>
                    }
                </div>
            }
            else if (_searched)
            {
                <p class="text-sm text-zinc-500 text-center py-2">No users found.</p>
            }
        </div>

        @if (_errorMessage is not null)
        {
            <p class="text-sm text-red-400">@_errorMessage</p>
        }

        <button @onclick="OnClose"
                class="w-full bg-zinc-800 hover:bg-zinc-700 text-zinc-300 font-medium py-2.5 rounded-xl text-sm transition-colors cursor-pointer">
            Close
        </button>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public int SettlementId { get; set; }
    [Parameter] public UserModel[] ExistingParticipants { get; set; } = [];
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback<UserModel> OnAdded { get; set; }

    private string _query = string.Empty;
    private UserModel[] _results = [];
    private bool _loading;
    private bool _searched;
    private int? _addingId;
    private string? _errorMessage;

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
            await SearchAsync();
    }

    private async Task SearchAsync()
    {
        _errorMessage = null;
        _results = [];

        if (string.IsNullOrWhiteSpace(_query))
            return;

        _loading = true;
        _searched = false;

        try
        {
            _results = await UserService.SearchAsync(_query.Trim());
            _searched = true;
        }
        catch
        {
            _errorMessage = "Search failed. Please try again.";
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task AddAsync(UserModel user)
    {
        _errorMessage = null;
        _addingId = user.Id;

        try
        {
            bool success = await SettlementService.AddUserAsync(SettlementId, user.Id);

            if (success)
            {
                await OnAdded.InvokeAsync(user);
                // Keep modal open so more users can be added; update local list so button shows "Added"
                ExistingParticipants = [.. ExistingParticipants, user];
            }
            else
            {
                _errorMessage = "Failed to add participant. Please try again.";
            }
        }
        catch
        {
            _errorMessage = "Failed to add participant. Please try again.";
        }
        finally
        {
            _addingId = null;
        }
    }
}
