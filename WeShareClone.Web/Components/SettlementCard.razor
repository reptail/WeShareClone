@using WeShareClone.Web.Models
@using WeShareClone.Web.Utilities
@inject EntryService EntryService
@inject ExchangeRateService ExchangeRateService

<div class="bg-zinc-900 border border-zinc-800 rounded-xl px-4 py-3 cursor-pointer hover:bg-zinc-800 transition-colors active:scale-[0.99]"
     @onclick="OnClick">
    <div class="flex items-start justify-between gap-3">
        <div class="min-w-0">
            <div class="flex items-center gap-2">
                <p class="font-medium text-zinc-100 truncate">@Settlement.Name</p>
                @if (Settlement.SettlementStatus == ESettlementStatus.BeingSettled)
                {
                    <span class="shrink-0 text-xs bg-yellow-500/20 text-yellow-400 px-1.5 py-0.5 rounded-full">Settling</span>
                }
                else if (Settlement.SettlementStatus == ESettlementStatus.Closed)
                {
                    <span class="shrink-0 text-xs bg-zinc-700 text-zinc-400 px-1.5 py-0.5 rounded-full">Closed</span>
                }
            </div>
            <p class="text-xs text-zinc-500 mt-0.5">@Settlement.Currency</p>
        </div>

        <div class="text-right shrink-0">
            @if (_balanceLoading)
            {
                <div class="h-4 w-16 bg-zinc-800 rounded animate-pulse"></div>
            }
            else if (_balance > 0)
            {
                <p class="text-sm font-semibold text-green-400">+@_balance.ToString("N2")</p>
                <p class="text-xs text-zinc-500">owed to you</p>
            }
            else if (_balance < 0)
            {
                <p class="text-sm font-semibold text-red-400">@_balance.ToString("N2")</p>
                <p class="text-xs text-zinc-500">you owe</p>
            }
            else
            {
                <p class="text-sm text-zinc-500">Settled up</p>
            }
        </div>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public SettlementModel Settlement { get; set; } = null!;
    [Parameter, EditorRequired] public int CurrentUserId { get; set; }
    [Parameter] public EventCallback OnClick { get; set; }

    private decimal _balance;
    private bool _balanceLoading = true;

    protected override async Task OnParametersSetAsync()
    {
        _balanceLoading = true;

        Task<EntryModel[]> entriesTask = EntryService.GetEntriesAsync(Settlement.Id);
        Task<ExchangeRateModel[]> ratesTask = ExchangeRateService.GetLatestAsync();

        await Task.WhenAll(entriesTask, ratesTask);

        ExchangeRateModel[] rates = await ratesTask;
        _balance = CalculateBalance(await entriesTask, rates);
        _balanceLoading = false;
    }

    private decimal CalculateBalance(EntryModel[] entries, ExchangeRateModel[] rates)
    {
        decimal total = 0;
        string settlementCurrency = Settlement.Currency;

        foreach (EntryModel entry in entries)
        {
            EntryDistributionModel? dist = entry.Distributions
                .FirstOrDefault(d => d.UserId == CurrentUserId);

            decimal userShare = (dist is null) ? 0 : entry.DistributionMode switch
            {
                "EvenSplit"   => entry.Distributions.Length > 0 ? entry.Value / entry.Distributions.Length : 0,
                "Percentage"  => entry.Value * dist.Factor,
                "FixedAmount" => dist.Factor,
                _             => 0
            };

            decimal entryValue        = CurrencyConverter.Convert(entry.Value,  entry.Currency, settlementCurrency, rates);
            decimal shareInSettlement = CurrencyConverter.Convert(userShare,     entry.Currency, settlementCurrency, rates);

            total += (entry.AddedBy == CurrentUserId ? entryValue : 0) - shareInSettlement;
        }

        return total;
    }
}
