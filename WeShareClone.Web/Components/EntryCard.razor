@using WeShareClone.Web.Models
@using WeShareClone.Web.Utilities

<div class="flex @(IsOwnEntry ? "justify-end" : "justify-start")">
    <div class="max-w-[80%] space-y-1">
        <div class="@CardClass rounded-2xl px-4 py-3 space-y-1 @(IsOwnEntry ? "rounded-br-sm" : "rounded-bl-sm")">
            <p class="font-medium text-sm">@Entry.Name</p>
            <div class="flex items-baseline gap-2">
                <span class="text-lg font-semibold">@Entry.Value.ToString("N2")</span>
                <span class="text-xs text-zinc-400 uppercase">@Entry.Currency</span>
            </div>
            @if (ConvertedValue is { } converted)
            {
                <p class="text-xs text-zinc-500">≈ @converted.ToString("N2") @SettlementCurrency</p>
            }
            @if (UserShare > 0)
            {
                <p class="text-xs @ShareTextClass">Your share: @UserShare.ToString("N2") @Entry.Currency</p>
            }
        </div>
        <div class="flex @(IsOwnEntry ? "justify-end" : "justify-start") items-center gap-2">
            <p class="text-xs text-zinc-500 px-1">
                @(IsOwnEntry ? "You" : AddedByName) · @Entry.AddedAtUtc.ToLocalTime().ToString("MMM d, HH:mm")
            </p>
            @if (IsOwnEntry && OnEdit.HasDelegate)
            {
                <button @onclick="() => OnEdit.InvokeAsync()"
                        class="text-xs text-zinc-500 hover:text-violet-400 transition-colors cursor-pointer px-1">
                    Edit
                </button>
            }
        </div>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public EntryModel Entry { get; set; } = null!;
    [Parameter, EditorRequired] public int CurrentUserId { get; set; }
    [Parameter] public UserModel[] Participants { get; set; } = [];
    [Parameter] public string SettlementCurrency { get; set; } = string.Empty;
    [Parameter] public ExchangeRateModel[] ExchangeRates { get; set; } = [];
    [Parameter] public EventCallback OnEdit { get; set; }

    private bool IsOwnEntry => Entry.AddedBy == CurrentUserId;

    private string CardClass =>
        IsOwnEntry
            ? "bg-violet-600/20 border border-violet-500/30 text-zinc-100"
            : "bg-zinc-900 border border-zinc-800 text-zinc-100";

    private string ShareTextClass =>
        IsOwnEntry ? "text-violet-300" : "text-zinc-400";

    private string AddedByName =>
        Participants.FirstOrDefault(p => p.Id == Entry.AddedBy)?.Name ?? $"User {Entry.AddedBy}";

    /// <summary>
    /// Returns the entry value converted to the settlement currency, or null when
    /// no conversion is needed (same currency) or rates are unavailable.
    /// </summary>
    private decimal? ConvertedValue
    {
        get
        {
            if (string.IsNullOrEmpty(SettlementCurrency)
                || string.Equals(Entry.Currency, SettlementCurrency, StringComparison.OrdinalIgnoreCase)
                || ExchangeRates.Length == 0)
            {
                return null;
            }

            return CurrencyConverter.Convert(Entry.Value, Entry.Currency, SettlementCurrency, ExchangeRates);
        }
    }

    private decimal UserShare
    {
        get
        {
            EntryDistributionModel? dist = Entry.Distributions
                .FirstOrDefault(d => d.UserId == CurrentUserId);

            if (dist is null) return 0;

            return Entry.DistributionMode switch
            {
                "EvenSplit"   => Entry.Distributions.Length > 0 ? Entry.Value / Entry.Distributions.Length : 0,
                "Percentage"  => Entry.Value * dist.Factor,
                "FixedAmount" => dist.Factor,
                _             => 0
            };
        }
    }
}
