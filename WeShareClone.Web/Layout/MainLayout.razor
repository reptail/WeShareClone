@inherits LayoutComponentBase
@inject AuthStateService AuthState
@inject AuthService AuthService
@inject NavigationManager Nav
@inject IJSRuntime JS

<div class="min-h-screen flex flex-col bg-zinc-950 text-zinc-100">
    @if (AuthState.IsAuthenticated)
    {
        <header class="sticky top-0 z-40 border-b border-zinc-800 bg-zinc-950/80 backdrop-blur-sm">
            <div class="max-w-2xl mx-auto px-4 h-14 flex items-center justify-between">
                <a href="/" class="font-semibold text-zinc-100 tracking-tight hover:text-white transition-colors">WeShare</a>

                <!-- User menu -->
                <div class="relative">
                    <button @onclick="ToggleMenu"
                            class="text-sm text-zinc-400 hover:text-zinc-100 transition-colors cursor-pointer flex items-center gap-2">
                        <img src="@GravatarUrl" alt="" width="28" height="28"
                             class="rounded-full bg-zinc-800 shrink-0" />
                        <span class="hidden sm:block">@AuthState.UserName</span>
                        <span class="text-zinc-600">▾</span>
                    </button>

                    @if (_menuOpen)
                    {
                        <!-- Backdrop to close on outside click -->
                        <div class="fixed inset-0 z-40" @onclick="CloseMenu"></div>

                        <!-- Dropdown -->
                        <div class="absolute right-0 top-full mt-2 w-52 bg-zinc-900 border border-zinc-800 rounded-xl shadow-xl z-50 py-1 overflow-hidden">
                            <div class="px-4 py-2 border-b border-zinc-800">
                                <p class="text-xs font-medium text-zinc-300 truncate">@AuthState.UserName</p>
                                <p class="text-xs text-zinc-500 truncate">@AuthState.UserEmail</p>
                            </div>

                            <a href="/account/passkeys" @onclick="CloseMenu"
                               class="w-full text-left px-4 py-2.5 text-sm text-zinc-300 hover:bg-zinc-800 transition-colors flex items-center gap-2">
                                <span>🔑</span>
                                <span>Manage passkeys</span>
                            </a>

                            <a href="/account/profile" @onclick="CloseMenu"
                               class="w-full text-left px-4 py-2.5 text-sm text-zinc-300 hover:bg-zinc-800 transition-colors flex items-center gap-2">
                                <span>✏️</span>
                                <span>Edit profile</span>
                            </a>

                            @if (AuthState.IsAdmin)
                            {
                                <button @onclick="CopyInviteLinkAsync"
                                        class="w-full text-left px-4 py-2.5 text-sm text-zinc-300 hover:bg-zinc-800 transition-colors cursor-pointer flex items-center gap-2">
                                    <span>🔗</span>
                                    <span>@(_inviteLinkStatus ?? "Copy invite link")</span>
                                </button>
                            }

                            <button @onclick="LogoutAsync"
                                    class="w-full text-left px-4 py-2.5 text-sm text-zinc-400 hover:bg-zinc-800 transition-colors cursor-pointer">
                                Sign out
                            </button>
                        </div>
                    }
                </div>
            </div>
        </header>
    }

    <main class="flex-1 max-w-2xl mx-auto w-full px-4 py-6">
        @Body
    </main>
</div>

@code {
    private bool _menuOpen;
    private string? _inviteLinkStatus;

    private string GravatarUrl
    {
        get
        {
            string email = AuthState.UserEmail.Trim().ToLowerInvariant();
            byte[] hash  = System.Security.Cryptography.SHA256.HashData(System.Text.Encoding.UTF8.GetBytes(email));
            string hex   = Convert.ToHexString(hash).ToLowerInvariant();
            return $"https://www.gravatar.com/avatar/{hex}?s=56&d=identicon";
        }
    }

    private void ToggleMenu() => _menuOpen = !_menuOpen;
    private void CloseMenu()  => _menuOpen = false;


    private async Task CopyInviteLinkAsync()
    {
        try
        {
            // Strip trailing JSON quotes if the API returns a quoted string
            string? raw = await AuthService.GetInviteTokenAsync();
            string? token = raw?.Trim('"');

            if (string.IsNullOrEmpty(token))
            {
                _inviteLinkStatus = "No invite token configured";
                return;
            }

            string link = $"{Nav.BaseUri}login?signup-token={Uri.EscapeDataString(token)}";
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", link);
            _inviteLinkStatus = "✓ Copied!";
        }
        catch
        {
            _inviteLinkStatus = "Failed to copy";
        }
        finally
        {
            await Task.Delay(2000);
            _inviteLinkStatus = null;
            StateHasChanged();
        }
    }

    private async Task LogoutAsync()
    {
        _menuOpen = false;
        await AuthState.ClearAsync();
        Nav.NavigateTo("/login");
    }
}
