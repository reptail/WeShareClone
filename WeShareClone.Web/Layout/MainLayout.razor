@inherits LayoutComponentBase
@inject AuthStateService AuthState
@inject AuthService AuthService
@inject NavigationManager Nav
@inject IJSRuntime JS

<div class="min-h-screen flex flex-col bg-zinc-950 text-zinc-100">
    @if (AuthState.IsAuthenticated)
    {
        <header class="sticky top-0 z-40 border-b border-zinc-800 bg-zinc-950/80 backdrop-blur-sm">
            <div class="max-w-2xl mx-auto px-4 h-14 flex items-center justify-between">
                <span class="font-semibold text-zinc-100 tracking-tight">WeShare</span>

                <!-- User menu -->
                <div class="relative">
                    <button @onclick="ToggleMenu"
                            class="text-sm text-zinc-400 hover:text-zinc-100 transition-colors cursor-pointer flex items-center gap-1">
                        <span class="hidden sm:block">@AuthState.UserName</span>
                        <span class="text-zinc-600">▾</span>
                    </button>

                    @if (_menuOpen)
                    {
                        <!-- Backdrop to close on outside click -->
                        <div class="fixed inset-0 z-40" @onclick="CloseMenu"></div>

                        <!-- Dropdown -->
                        <div class="absolute right-0 top-full mt-2 w-52 bg-zinc-900 border border-zinc-800 rounded-xl shadow-xl z-50 py-1 overflow-hidden">
                            <div class="px-4 py-2 border-b border-zinc-800">
                                <p class="text-xs font-medium text-zinc-300 truncate">@AuthState.UserName</p>
                                <p class="text-xs text-zinc-500 truncate">@AuthState.UserEmail</p>
                            </div>

                            <button @onclick="RegisterPasskeyAsync"
                                    disabled="@_passkeyBusy"
                                    class="w-full text-left px-4 py-2.5 text-sm text-zinc-300 hover:bg-zinc-800 disabled:opacity-50 disabled:cursor-not-allowed transition-colors cursor-pointer flex items-center gap-2">
                                <span>🔑</span>
                                <span>@(_passkeyBusy ? "Registering…" : "Register passkey")</span>
                            </button>

                            @if (_passkeyStatus is not null)
                            {
                                <p class="px-4 pb-2 text-xs @(_passkeyError ? "text-red-400" : "text-green-400")">
                                    @_passkeyStatus
                                </p>
                            }

                            <button @onclick="LogoutAsync"
                                    class="w-full text-left px-4 py-2.5 text-sm text-zinc-400 hover:bg-zinc-800 transition-colors cursor-pointer">
                                Sign out
                            </button>
                        </div>
                    }
                </div>
            </div>
        </header>
    }

    <main class="flex-1 max-w-2xl mx-auto w-full px-4 py-6">
        @Body
    </main>
</div>

@code {
    private bool _menuOpen;
    private bool _passkeyBusy;
    private string? _passkeyStatus;
    private bool _passkeyError;

    private void ToggleMenu() => _menuOpen = !_menuOpen;
    private void CloseMenu()  => _menuOpen = false;

    private async Task RegisterPasskeyAsync()
    {
        _passkeyStatus = null;
        _passkeyBusy   = true;

        try
        {
            string? optionsJson = await AuthService.PasskeyRegisterBeginAsync();

            if (optionsJson is null)
            {
                _passkeyError  = true;
                _passkeyStatus = "Could not start registration. Please try again.";
                return;
            }

            string attestationJson = await JS.InvokeAsync<string>("startPasskeyRegistration", optionsJson);

            bool success = await AuthService.PasskeyRegisterCompleteAsync(attestationJson);

            _passkeyError  = !success;
            _passkeyStatus = success ? "✓ Passkey registered!" : "Registration failed. Please try again.";

            if (success)
            {
                // Auto-close menu after a short delay so the user sees the confirmation
                await Task.Delay(1500);
                _menuOpen      = false;
                _passkeyStatus = null;
            }
        }
        catch (JSException)
        {
            _passkeyError  = true;
            _passkeyStatus = "Cancelled or not supported by this device.";
        }
        catch
        {
            _passkeyError  = true;
            _passkeyStatus = "Something went wrong. Please try again.";
        }
        finally
        {
            _passkeyBusy = false;
        }
    }

    private async Task LogoutAsync()
    {
        _menuOpen = false;
        await AuthState.ClearAsync();
        Nav.NavigateTo("/login");
    }
}
