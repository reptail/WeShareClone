@page "/account/passkeys"
@inject AuthStateService AuthState
@inject AuthService AuthService
@inject NavigationManager Nav
@inject IJSRuntime JS

<PageTitle>Passkeys – WeShare</PageTitle>

@if (!AuthState.IsAuthenticated)
{
    return;
}

<div class="space-y-6">
    <div class="flex items-center justify-between">
        <h1 class="text-xl font-semibold">Passkeys</h1>
    </div>

    @if (_addError is not null)
    {
        <p class="text-sm text-red-400">@_addError</p>
    }

    @if (_addSuccess)
    {
        <p class="text-sm text-green-400">✓ Passkey registered successfully.</p>
    }

    <!-- Add passkey section -->
    <div class="bg-zinc-900 border border-zinc-800 rounded-2xl p-4 space-y-3">
        <p class="text-sm font-medium text-zinc-300">Register a new passkey</p>
        <div class="space-y-1">
            <label class="text-xs text-zinc-500">Name <span class="text-zinc-600">(optional)</span></label>
            <input @bind="_newKeyName" @bind:event="oninput"
                   placeholder="e.g. MacBook Touch ID"
                   disabled="@_adding"
                   class="w-full bg-zinc-800 border border-zinc-700 rounded-xl px-3 py-2 text-sm text-zinc-100 placeholder:text-zinc-500 focus:outline-none focus:border-violet-500 transition-colors disabled:opacity-50" />
        </div>
        <button @onclick="AddPasskeyAsync"
                disabled="@_adding"
                class="bg-violet-600 hover:bg-violet-500 disabled:opacity-50 disabled:cursor-not-allowed text-white text-sm font-medium px-4 py-2 rounded-xl transition-colors cursor-pointer">
            @(_adding ? "Registering…" : "+ Add passkey")
        </button>
    </div>

    @if (_loading)
    {
        <p class="text-sm text-zinc-500">Loading…</p>
    }
    else if (_passkeys.Length == 0)
    {
        <div class="bg-zinc-900 border border-zinc-800 rounded-2xl p-6 text-center text-sm text-zinc-500">
            No passkeys registered yet.
        </div>
    }
    else
    {
        <div class="space-y-2">
            @foreach (PasskeyCredentialModel key in _passkeys)
            {
                <div class="bg-zinc-900 border border-zinc-800 rounded-2xl px-4 py-3 space-y-2">
                    @if (_editingId == key.Id)
                    {
                        <!-- Inline rename form -->
                        <div class="flex items-center gap-2">
                            <input @bind="_editName" @bind:event="oninput"
                                   placeholder="Passkey name"
                                   class="flex-1 bg-zinc-800 border border-zinc-700 rounded-lg px-3 py-1.5 text-sm text-zinc-100 placeholder:text-zinc-500 focus:outline-none focus:border-violet-500 transition-colors" />
                            <button @onclick="() => SaveNameAsync(key.Id)"
                                    disabled="@_savingId"
                                    class="text-xs bg-violet-600 hover:bg-violet-500 disabled:opacity-50 text-white px-3 py-1.5 rounded-lg transition-colors cursor-pointer">
                                @(_savingId ? "…" : "Save")
                            </button>
                            <button @onclick="CancelEdit"
                                    class="text-xs text-zinc-500 hover:text-zinc-300 transition-colors cursor-pointer">
                                Cancel
                            </button>
                        </div>
                    }
                    else
                    {
                        <div class="flex items-center justify-between gap-4">
                            <div class="flex items-center gap-3 min-w-0">
                                <span class="text-xl">🔑</span>
                                <div class="min-w-0">
                                    <p class="text-sm font-medium text-zinc-200 truncate">@(key.Name ?? "Passkey")</p>
                                    <p class="text-xs text-zinc-500">Registered @key.CreatedAtUtc.ToLocalTime().ToString("d MMM yyyy, HH:mm")</p>
                                </div>
                            </div>
                            <div class="flex items-center gap-3 shrink-0">
                                <button @onclick="() => StartEdit(key.Id, key.Name)"
                                        class="text-xs text-zinc-500 hover:text-zinc-300 transition-colors cursor-pointer">
                                    ✏️
                                </button>
                                <button @onclick="() => DeleteAsync(key.Id)"
                                        disabled="@_deletingId.Contains(key.Id)"
                                        class="text-xs text-red-400 hover:text-red-300 disabled:opacity-50 disabled:cursor-not-allowed transition-colors cursor-pointer">
                                    @(_deletingId.Contains(key.Id) ? "Removing…" : "Remove")
                                </button>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    }
</div>

@code {
    private PasskeyCredentialModel[] _passkeys = [];
    private bool    _loading    = true;
    private bool    _adding;
    private bool    _addSuccess;
    private string? _addError;
    private string  _newKeyName = string.Empty;
    private HashSet<int> _deletingId = [];

    // Inline rename state
    private int?    _editingId;
    private string  _editName  = string.Empty;
    private bool    _savingId;

    protected override async Task OnInitializedAsync()
    {
        if (!AuthState.IsAuthenticated)
        {
            Nav.NavigateTo("/login");
            return;
        }

        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        try
        {
            _passkeys = await AuthService.GetPasskeysAsync();
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task AddPasskeyAsync()
    {
        _addError   = null;
        _addSuccess = false;
        _adding     = true;

        try
        {
            string? optionsJson = await AuthService.PasskeyRegisterBeginAsync();

            if (optionsJson is null)
            {
                _addError = "Could not start registration. Please try again.";
                return;
            }

            string attestationJson = await JS.InvokeAsync<string>("startPasskeyRegistration", optionsJson);
            PasskeyCredentialModel? created = await AuthService.PasskeyRegisterCompleteAsync(attestationJson);

            if (created is null)
            {
                _addError = "Registration failed. Please try again.";
                return;
            }

            // If the user gave a name, persist it immediately.
            string? trimmedName = string.IsNullOrWhiteSpace(_newKeyName) ? null : _newKeyName.Trim();
            if (trimmedName is not null)
            {
                PasskeyCredentialModel? renamed = await AuthService.RenamePasskeyAsync(created.Id, trimmedName);
                if (renamed is not null)
                {
                    _passkeys = [.. _passkeys, renamed];
                }
                else
                {
                    _passkeys = [.. _passkeys, created];
                }
            }
            else
            {
                _passkeys = [.. _passkeys, created];
            }

            _addSuccess  = true;
            _newKeyName  = string.Empty;
        }
        catch (JSException)
        {
            _addError = "Cancelled or not supported by this device.";
        }
        catch
        {
            _addError = "Something went wrong. Please try again.";
        }
        finally
        {
            _adding = false;
        }
    }

    private void StartEdit(int id, string? currentName)
    {
        _editingId = id;
        _editName  = currentName ?? string.Empty;
    }

    private void CancelEdit()
    {
        _editingId = null;
        _editName  = string.Empty;
    }

    private async Task SaveNameAsync(int id)
    {
        _savingId = true;
        try
        {
            string? newName = string.IsNullOrWhiteSpace(_editName) ? null : _editName.Trim();
            PasskeyCredentialModel? updated = await AuthService.RenamePasskeyAsync(id, newName);

            if (updated is not null)
            {
                _passkeys = _passkeys
                    .Select(k => k.Id == id ? updated : k)
                    .ToArray();
            }

            _editingId = null;
            _editName  = string.Empty;
        }
        finally
        {
            _savingId = false;
        }
    }

    private async Task DeleteAsync(int id)
    {
        _deletingId.Add(id);

        try
        {
            bool success = await AuthService.DeletePasskeyAsync(id);
            if (success)
                _passkeys = _passkeys.Where(k => k.Id != id).ToArray();
        }
        finally
        {
            _deletingId.Remove(id);
        }
    }
}
