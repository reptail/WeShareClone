@page "/settlements/{Id:int}"
@using WeShareClone.Web.Models
@using WeShareClone.Web.Utilities
@inject AuthStateService AuthState
@inject SettlementService SettlementService
@inject EntryService EntryService
@inject ExchangeRateService ExchangeRateService
@inject NavigationManager Nav
@inject IJSRuntime JS

<PageTitle>@(_settlement?.Name ?? "Settlement") – WeShare</PageTitle>

@if (_loading)
{
    <div class="space-y-3">
        <div class="h-8 w-48 bg-zinc-900 rounded-lg animate-pulse"></div>
        @for (int i = 0; i < 4; i++)
        {
            <div class="h-24 bg-zinc-900 rounded-xl animate-pulse"></div>
        }
    </div>
}
else if (_settlement is null)
{
    <div class="text-center py-16 text-zinc-500 text-sm">Settlement not found.</div>
}
else
{
    bool isCreator = _settlement.CreatedBy == AuthState.UserId;
    bool isOpen = _settlement.SettlementStatus == ESettlementStatus.Open;
    bool isSettling = _settlement.SettlementStatus == ESettlementStatus.BeingSettled;
    bool isClosed = _settlement.SettlementStatus == ESettlementStatus.Closed;
    bool allPaid = _debts.Length > 0 && _debts.All(d => d.IsPaid);

    <div class="space-y-4 pb-24">
        <!-- Header -->
        <div class="flex items-start justify-between gap-3">
            <div class="flex items-center gap-3">
                <button @onclick='() => Nav.NavigateTo("/")'
                        class="text-zinc-400 hover:text-zinc-100 transition-colors cursor-pointer text-lg leading-none shrink-0">
                    ←
                </button>
                <div>
                    <h1 class="text-xl font-semibold">@_settlement.Name</h1>
                    <p class="text-xs text-zinc-500">
                        @_settlement.Currency ·
                        @if (isOpen)
                        {
                            <span>Open</span>
                        }
                        else if (isSettling)
                        {
                            <span class="text-yellow-400">Settling</span>
                        }
                        else
                        {
                            <span class="text-zinc-400">Closed</span>
                        }
                    </p>
                </div>
            </div>

            <!-- Creator lifecycle actions -->
            @if (isCreator)
            {
                @if (isOpen)
                {
                    <button @onclick="StartSettlingAsync"
                            disabled="@_actionInProgress"
                            class="shrink-0 text-xs bg-yellow-500/20 text-yellow-400 hover:bg-yellow-500/30 border border-yellow-500/30 px-3 py-1.5 rounded-lg transition-colors cursor-pointer disabled:opacity-50">
                        Start settling
                    </button>
                }
                else if (isSettling)
                {
                    <div class="flex gap-2 shrink-0">
                        <button @onclick="RevertToOpenAsync"
                                disabled="@_actionInProgress"
                                class="text-xs text-zinc-400 hover:text-zinc-200 border border-zinc-700 hover:border-zinc-500 px-3 py-1.5 rounded-lg transition-colors cursor-pointer disabled:opacity-50">
                            Revert to open
                        </button>
                        <button @onclick="CloseSettlementAsync"
                                disabled="@(!allPaid || _actionInProgress)"
                                class="text-xs bg-zinc-700 hover:bg-zinc-600 disabled:opacity-40 disabled:cursor-not-allowed px-3 py-1.5 rounded-lg transition-colors cursor-pointer">
                            Close
                        </button>
                    </div>
                }
                else if (isClosed)
                {
                    <button @onclick="ReopenAsync"
                            disabled="@_actionInProgress"
                            class="shrink-0 text-xs text-violet-400 hover:text-violet-300 border border-violet-500/30 hover:border-violet-400/50 px-3 py-1.5 rounded-lg transition-colors cursor-pointer disabled:opacity-50">
                        Reopen
                    </button>
                }
            }
        </div>

        @if (_actionError is not null)
        {
            <div class="text-xs text-red-400 bg-red-500/10 border border-red-500/20 rounded-lg px-3 py-2">
                @_actionError
            </div>
        }

        <!-- Balance summary (only relevant when open/settling) -->
        @if (!isClosed)
        {
            <div class="bg-zinc-900 border border-zinc-800 rounded-xl px-4 py-3">
                @{
                    decimal balance = CalculateTotalBalance();
                }
                @if (balance > 0)
                {
                    <p class="text-sm text-green-400 font-medium">You are owed @balance.ToString("N2") @_settlement.Currency</p>
                }
                else if (balance < 0)
                {
                    <p class="text-sm text-red-400 font-medium">You owe @(Math.Abs(balance).ToString("N2")) @_settlement.Currency</p>
                }
                else
                {
                    <p class="text-sm text-zinc-400">All settled up ✓</p>
                }
            </div>
        }

        <!-- Debt breakdown (BeingSettled or Closed) -->
        @if ((isSettling || isClosed) && _debts.Length > 0)
        {
            <div class="bg-zinc-900 border border-zinc-800 rounded-xl px-4 py-3 space-y-3">
                <p class="text-xs font-medium text-zinc-400 uppercase tracking-wide">Payments to make</p>
                @foreach (SettlementDebtModel debt in _debts)
                {
                    UserModel? from = _participants.FirstOrDefault(p => p.Id == debt.FromUserId);
                    UserModel? to   = _participants.FirstOrDefault(p => p.Id == debt.ToUserId);
                    string fromName = from?.Name ?? $"User {debt.FromUserId}";
                    string toName   = to?.Name   ?? $"User {debt.ToUserId}";

                    <div class="flex items-center justify-between gap-3">
                        <div class="min-w-0">
                            <p class="text-sm @(debt.IsPaid ? "line-through text-zinc-500" : "text-zinc-200")">
                                @fromName → @toName
                            </p>
                            <p class="text-xs text-zinc-500">
                                @debt.Amount.ToString("N2") @debt.Currency
                            </p>
                        </div>
                        @if (!isClosed)
                        {
                            <button @onclick="() => ToggleDebtPaidAsync(debt)"
                                    disabled="@_actionInProgress"
                                    class="shrink-0 text-xs px-3 py-1.5 rounded-lg border transition-colors cursor-pointer disabled:opacity-50
                                           @(debt.IsPaid
                                               ? "border-green-500/40 bg-green-500/10 text-green-400 hover:bg-green-500/20"
                                               : "border-zinc-600 text-zinc-400 hover:border-zinc-400 hover:text-zinc-200")">
                                @(debt.IsPaid ? "✓ Paid" : "Mark paid")
                            </button>
                        }
                        else
                        {
                            <span class="shrink-0 text-xs text-green-400">✓ Paid</span>
                        }
                    </div>
                }
            </div>
        }
        else if (isSettling && _debts.Length == 0)
        {
            <div class="bg-zinc-900 border border-zinc-800 rounded-xl px-4 py-3">
                <p class="text-sm text-zinc-400">No payments needed — everyone is settled up!</p>
            </div>
        }

        <!-- Participants -->
        <div class="bg-zinc-900 border border-zinc-800 rounded-xl px-4 py-3 space-y-2">
            <div class="flex items-center justify-between">
                <p class="text-xs font-medium text-zinc-400 uppercase tracking-wide">Participants</p>
                @if (isOpen)
                {
                    <button @onclick="() => _showAddParticipant = true"
                            class="text-xs text-violet-400 hover:text-violet-300 transition-colors cursor-pointer">
                        + Add
                    </button>
                }
            </div>
            <div class="flex flex-wrap gap-2">
                @foreach (UserModel participant in _participants)
                {
                    <span class="bg-zinc-800 border border-zinc-700 rounded-full px-3 py-1 text-xs text-zinc-300">
                        @participant.Name
                    </span>
                }
            </div>
        </div>

        @if (_entries.Length == 0)
        {
            <div class="text-center py-12 text-zinc-500 text-sm">No entries yet. Add the first one!</div>
        }
        else
        {
            <div class="space-y-2">
                @foreach (EntryModel entry in _entries.OrderBy(e => e.AddedAtUtc))
                {
                    <EntryCard Entry="entry"
                               CurrentUserId="AuthState.UserId"
                               Participants="_participants"
                               SettlementCurrency="@(_settlement.Currency)"
                               ExchangeRates="_exchangeRates"
                               OnEdit="@(isOpen ? EventCallback.Factory.Create(this, () => _editingEntry = entry) : default)" />
                }
            </div>
        }

        <div @ref="_bottomAnchor"></div>
    </div>

    <!-- Add entry FAB — only when open -->
    @if (isOpen)
    {
        <button @onclick="() => _showAddEntry = true"
                class="fixed bottom-6 right-6 bg-violet-600 hover:bg-violet-500 active:bg-violet-700 text-white rounded-full shadow-lg px-5 py-3 text-sm font-medium transition-colors z-30 cursor-pointer">
            + Add entry
        </button>
    }

    @if (_showAddEntry)
    {
        <AddEntryModal Settlement="_settlement"
                       Participants="_participants"
                       OnClose="() => _showAddEntry = false"
                       OnCreated="OnEntryCreated" />
    }

    @if (_showAddParticipant)
    {
        <AddParticipantModal SettlementId="_settlement.Id"
                             ExistingParticipants="_participants"
                             OnClose="() => _showAddParticipant = false"
                             OnAdded="OnParticipantAdded" />
    }

    @if (_editingEntry is not null)
    {
        <EditEntryModal Entry="_editingEntry"
                        Settlement="_settlement"
                        Participants="_participants"
                        OnClose="() => _editingEntry = null"
                        OnUpdated="OnEntryUpdated" />
    }
}

@code {
    [Parameter] public int Id { get; set; }

    private SettlementModel? _settlement;
    private EntryModel[] _entries = [];
    private UserModel[] _participants = [];
    private ExchangeRateModel[] _exchangeRates = [];
    private SettlementDebtModel[] _debts = [];
    private bool _loading = true;
    private bool _showAddEntry;
    private bool _showAddParticipant;
    private EntryModel? _editingEntry;
    private ElementReference _bottomAnchor;
    private bool _scrollToBottom;
    private bool _actionInProgress;
    private string? _actionError;

    protected override async Task OnInitializedAsync()
    {
        if (!AuthState.IsAuthenticated)
        {
            Nav.NavigateTo("/login");
            return;
        }

        await LoadAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_scrollToBottom)
        {
            _scrollToBottom = false;
            await JS.InvokeVoidAsync("scrollIntoView", _bottomAnchor);
        }
    }

    private async Task LoadAsync()
    {
        _loading = true;

        Task<SettlementModel?> settlementTask  = SettlementService.GetByIdAsync(Id);
        Task<EntryModel[]> entriesTask          = EntryService.GetEntriesAsync(Id);
        Task<UserModel[]> participantsTask      = SettlementService.GetParticipantsAsync(Id);
        Task<ExchangeRateModel[]> ratesTask     = ExchangeRateService.GetLatestAsync();

        await Task.WhenAll(settlementTask, entriesTask, participantsTask, ratesTask);

        _settlement    = await settlementTask;
        _entries       = await entriesTask;
        _participants  = await participantsTask;
        _exchangeRates = await ratesTask;

        if (_settlement is not null && _settlement.SettlementStatus != ESettlementStatus.Open)
            _debts = await SettlementService.GetDebtsAsync(Id);

        _loading = false;
        _scrollToBottom = true;
    }

    private async Task OnEntryCreated(EntryModel entry)
    {
        _showAddEntry = false;
        _entries = await EntryService.GetEntriesAsync(Id);
        _scrollToBottom = true;
    }

    private async Task OnEntryUpdated(EntryModel entry)
    {
        _editingEntry = null;
        _entries = await EntryService.GetEntriesAsync(Id);
        _scrollToBottom = true;
    }

    private async Task OnParticipantAdded(UserModel user)
    {
        _participants = await SettlementService.GetParticipantsAsync(Id);
    }

    private async Task StartSettlingAsync()
    {
        _actionInProgress = true;
        _actionError = null;
        SettlementDebtModel[]? debts = await SettlementService.StartSettlingAsync(Id);
        if (debts is not null)
        {
            _debts = debts;
            _settlement = await SettlementService.GetByIdAsync(Id);
        }
        else
        {
            _actionError = "Failed to start settling. Please try again.";
        }
        _actionInProgress = false;
    }

    private async Task RevertToOpenAsync()
    {
        _actionInProgress = true;
        _actionError = null;
        bool ok = await SettlementService.RevertToOpenAsync(Id);
        if (ok)
        {
            _debts = [];
            _settlement = await SettlementService.GetByIdAsync(Id);
        }
        else
        {
            _actionError = "Failed to revert. Please try again.";
        }
        _actionInProgress = false;
    }

    private async Task CloseSettlementAsync()
    {
        _actionInProgress = true;
        _actionError = null;
        bool ok = await SettlementService.CloseAsync(Id);
        if (ok)
        {
            _settlement = await SettlementService.GetByIdAsync(Id);
        }
        else
        {
            _actionError = "Failed to close. Make sure all debts are paid first.";
        }
        _actionInProgress = false;
    }

    private async Task ReopenAsync()
    {
        _actionInProgress = true;
        _actionError = null;
        bool ok = await SettlementService.ReopenAsync(Id);
        if (ok)
        {
            _debts = [];
            _settlement = await SettlementService.GetByIdAsync(Id);
        }
        else
        {
            _actionError = "Failed to reopen. Please try again.";
        }
        _actionInProgress = false;
    }

    private async Task ToggleDebtPaidAsync(SettlementDebtModel debt)
    {
        _actionInProgress = true;
        _actionError = null;
        SettlementDebtModel? updated = await SettlementService.MarkDebtPaidAsync(Id, debt.Id, !debt.IsPaid);
        if (updated is not null)
        {
            _debts = _debts.Select(d => d.Id == updated.Id ? updated : d).ToArray();
        }
        else
        {
            _actionError = "Failed to update payment. Please try again.";
        }
        _actionInProgress = false;
    }

    /// <summary>
    /// Calculates the current user's net balance across all entries.
    /// Positive = owed to user; negative = user owes.
    /// </summary>
    private decimal CalculateTotalBalance()
    {
        if (_settlement is null) return 0;

        decimal total = 0;
        string settlementCurrency = _settlement.Currency;

        foreach (EntryModel entry in _entries)
        {
            decimal userShare    = CalculateUserShare(entry);
            decimal entryValue   = CurrencyConverter.Convert(entry.Value,   entry.Currency, settlementCurrency, _exchangeRates);
            decimal shareInSettlement = CurrencyConverter.Convert(userShare, entry.Currency, settlementCurrency, _exchangeRates);

            total += (entry.AddedBy == AuthState.UserId ? entryValue : 0) - shareInSettlement;
        }

        return total;
    }

    private decimal CalculateUserShare(EntryModel entry)
    {
        EntryDistributionModel? dist = entry.Distributions
            .FirstOrDefault(d => d.UserId == AuthState.UserId);

        if (dist is null)
        {
            return 0;
        }

        return entry.DistributionMode switch
        {
            // EvenSplit: all factors are equal, so share = total / count
            "EvenSplit" => entry.Distributions.Length > 0
                ? entry.Value / entry.Distributions.Length
                : 0,

            // Percentage: factor is the user's share of the total
            "Percentage" => entry.Value * dist.Factor,

            // FixedAmount: factor is the exact amount owed
            "FixedAmount" => dist.Factor,

            _ => 0
        };
    }
}

