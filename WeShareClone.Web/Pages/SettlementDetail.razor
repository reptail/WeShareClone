@page "/settlements/{Id:int}"
@using WeShareClone.Web.Models
@using WeShareClone.Web.Utilities
@inject AuthStateService AuthState
@inject SettlementService SettlementService
@inject EntryService EntryService
@inject ExchangeRateService ExchangeRateService
@inject NavigationManager Nav
@inject IJSRuntime JS

<PageTitle>@(_settlement?.Name ?? "Settlement") – WeShare</PageTitle>

@if (_loading)
{
    <div class="space-y-3">
        <div class="h-8 w-48 bg-zinc-900 rounded-lg animate-pulse"></div>
        @for (int i = 0; i < 4; i++)
        {
            <div class="h-24 bg-zinc-900 rounded-xl animate-pulse"></div>
        }
    </div>
}
else if (_settlement is null)
{
    <div class="text-center py-16 text-zinc-500 text-sm">Settlement not found.</div>
}
else
{
    <div class="space-y-4 pb-24">
        <!-- Header -->
        <div class="flex items-center gap-3">
            <button @onclick='() => Nav.NavigateTo("/")'
                    class="text-zinc-400 hover:text-zinc-100 transition-colors cursor-pointer text-lg leading-none">
                ←
            </button>
            <div>
                <h1 class="text-xl font-semibold">@_settlement.Name</h1>
                <p class="text-xs text-zinc-500">@_settlement.Currency · @(_settlement.IsOpen ? "Open" : "Closed")</p>
            </div>
        </div>

        <!-- Balance summary -->
        <div class="bg-zinc-900 border border-zinc-800 rounded-xl px-4 py-3">
            @{
                decimal balance = CalculateTotalBalance();
            }
            @if (balance > 0)
            {
                <p class="text-sm text-green-400 font-medium">You are owed @balance.ToString("N2") @_settlement.Currency</p>
            }
            else if (balance < 0)
            {
                <p class="text-sm text-red-400 font-medium">You owe @(Math.Abs(balance).ToString("N2")) @_settlement.Currency</p>
            }
            else
            {
                <p class="text-sm text-zinc-400">All settled up ✓</p>
            }
        </div>

        <!-- Participants -->
        <div class="bg-zinc-900 border border-zinc-800 rounded-xl px-4 py-3 space-y-2">
            <div class="flex items-center justify-between">
                <p class="text-xs font-medium text-zinc-400 uppercase tracking-wide">Participants</p>
                <button @onclick="() => _showAddParticipant = true"
                        class="text-xs text-violet-400 hover:text-violet-300 transition-colors cursor-pointer">
                    + Add
                </button>
            </div>
            <div class="flex flex-wrap gap-2">
                @foreach (UserModel participant in _participants)
                {
                    <span class="bg-zinc-800 border border-zinc-700 rounded-full px-3 py-1 text-xs text-zinc-300">
                        @participant.Name
                    </span>
                }
            </div>
        </div>

        @if (_entries.Length == 0)
        {
            <div class="text-center py-12 text-zinc-500 text-sm">No entries yet. Add the first one!</div>
        }
        else
        {
            <div class="space-y-2">
                @foreach (EntryModel entry in _entries.OrderBy(e => e.AddedAtUtc))
                {
                    <EntryCard Entry="entry"
                               CurrentUserId="AuthState.UserId"
                               Participants="_participants"
                               SettlementCurrency="@(_settlement.Currency)"
                               ExchangeRates="_exchangeRates"
                               OnEdit="() => _editingEntry = entry" />
                }
            </div>
        }

        <div @ref="_bottomAnchor"></div>
    </div>

    <!-- Add entry FAB -->
    <button @onclick="() => _showAddEntry = true"
            class="fixed bottom-6 right-6 bg-violet-600 hover:bg-violet-500 active:bg-violet-700 text-white rounded-full shadow-lg px-5 py-3 text-sm font-medium transition-colors z-30 cursor-pointer">
        + Add entry
    </button>

    @if (_showAddEntry)
    {
        <AddEntryModal Settlement="_settlement"
                       Participants="_participants"
                       OnClose="() => _showAddEntry = false"
                       OnCreated="OnEntryCreated" />
    }

    @if (_showAddParticipant)
    {
        <AddParticipantModal SettlementId="_settlement.Id"
                             ExistingParticipants="_participants"
                             OnClose="() => _showAddParticipant = false"
                             OnAdded="OnParticipantAdded" />
    }

    @if (_editingEntry is not null)
    {
        <EditEntryModal Entry="_editingEntry"
                        Settlement="_settlement"
                        Participants="_participants"
                        OnClose="() => _editingEntry = null"
                        OnUpdated="OnEntryUpdated" />
    }
}

@code {
    [Parameter] public int Id { get; set; }

    private SettlementModel? _settlement;
    private EntryModel[] _entries = [];
    private UserModel[] _participants = [];
    private ExchangeRateModel[] _exchangeRates = [];
    private bool _loading = true;
    private bool _showAddEntry;
    private bool _showAddParticipant;
    private EntryModel? _editingEntry;
    private ElementReference _bottomAnchor;

    protected override async Task OnInitializedAsync()
    {
        if (!AuthState.IsAuthenticated)
        {
            Nav.NavigateTo("/login");
            return;
        }

        await LoadAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_scrollToBottom)
        {
            _scrollToBottom = false;
            await JS.InvokeVoidAsync("scrollIntoView", _bottomAnchor);
        }
    }

    private bool _scrollToBottom;

    private async Task LoadAsync()
    {
        _loading = true;

        Task<SettlementModel?> settlementTask  = SettlementService.GetByIdAsync(Id);
        Task<EntryModel[]> entriesTask          = EntryService.GetEntriesAsync(Id);
        Task<UserModel[]> participantsTask      = SettlementService.GetParticipantsAsync(Id);
        Task<ExchangeRateModel[]> ratesTask     = ExchangeRateService.GetLatestAsync();

        await Task.WhenAll(settlementTask, entriesTask, participantsTask, ratesTask);

        _settlement    = await settlementTask;
        _entries       = await entriesTask;
        _participants  = await participantsTask;
        _exchangeRates = await ratesTask;

        _loading = false;
        _scrollToBottom = true;
    }

    private async Task OnEntryCreated(EntryModel entry)
    {
        _showAddEntry = false;
        // Refresh entries list and scroll to the new entry at the bottom
        _entries = await EntryService.GetEntriesAsync(Id);
        _scrollToBottom = true;
    }

    private async Task OnEntryUpdated(EntryModel entry)
    {
        _editingEntry = null;
        _entries = await EntryService.GetEntriesAsync(Id);
        _scrollToBottom = true;
    }

    private async Task OnParticipantAdded(UserModel user)
    {
        _showAddParticipant = false;
        _participants = await SettlementService.GetParticipantsAsync(Id);
    }

    /// <summary>
    /// Calculates the current user's net balance across all entries.
    /// Positive = owed to user; negative = user owes.
    /// </summary>
    private decimal CalculateTotalBalance()
    {
        if (_settlement is null) return 0;

        decimal total = 0;
        string settlementCurrency = _settlement.Currency;

        foreach (EntryModel entry in _entries)
        {
            decimal userShare    = CalculateUserShare(entry);
            decimal entryValue   = CurrencyConverter.Convert(entry.Value,   entry.Currency, settlementCurrency, _exchangeRates);
            decimal shareInSettlement = CurrencyConverter.Convert(userShare, entry.Currency, settlementCurrency, _exchangeRates);

            total += (entry.AddedBy == AuthState.UserId ? entryValue : 0) - shareInSettlement;
        }

        return total;
    }

    private decimal CalculateUserShare(EntryModel entry)
    {
        EntryDistributionModel? dist = entry.Distributions
            .FirstOrDefault(d => d.UserId == AuthState.UserId);

        if (dist is null)
        {
            return 0;
        }

        return entry.DistributionMode switch
        {
            // EvenSplit: all factors are equal, so share = total / count
            "EvenSplit" => entry.Distributions.Length > 0
                ? entry.Value / entry.Distributions.Length
                : 0,

            // Percentage: factor is the user's share of the total
            "Percentage" => entry.Value * dist.Factor,

            // FixedAmount: factor is the exact amount owed
            "FixedAmount" => dist.Factor,

            _ => 0
        };
    }
}
